{
  "provider": {
    "provider": "gemini",
    "model": "gemini-3.8-flash",
    "api_key_env": "GEMINI_API_KEY",
    "live_enabled": false,
    "timeout_seconds": 20,
    "max_retries": 1,
    "retry_base_seconds": 0.25,
    "max_output_tokens": 8192,
    "schema_mode": "schema"
